# ============================================
# Time Tracking Agents (Mac & Windows)
# ============================================

# Agent Databases (SQLite)
mac_agent/*.sqlite3
mac_agent/*.db
windows_agent/*.sqlite3
windows_agent/*.db

# Agent Configuration (contains API keys!)
mac_agent/config.json
windows_agent/config.json
.timetracker/
~/.timetracker/

# Agent Runtime Files
mac_agent/*.pid
windows_agent/*.pid
*.pid

# Agent Data & State
mac_agent/clients.json
mac_agent/gui_state.json
windows_agent/clients.json
windows_agent/gui_state.json
mac_agent/.device_id
windows_agent/.device_id

# Agent Logs
mac_agent/logs/
windows_agent/logs/
~/Library/Logs/ActivityAgent/
%APPDATA%/TimeTracker/logs/

# Agent Build Artifacts (PyInstaller)
mac_agent/build/
mac_agent/dist/
mac_agent/*.spec
windows_agent/build/
windows_agent/dist/
windows_agent/*.spec

# macOS LaunchAgent
~/Library/LaunchAgents/com.mavops.activityagent.plist

# Windows Startup
**/startup.lnk

