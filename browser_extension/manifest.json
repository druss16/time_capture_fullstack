{
  "manifest_version": 3,
  "name": "TimeTracker URL Reporter",
  "version": "1.3.0",
  "description": "Reports the active tab's URL to the local TimeTracker agent for accurate client attribution. Reads tab URL/title only; never page contents.",

  "minimum_chrome_version": "102",

  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "cookies",
    "scripting"
  ],

  "host_permissions": [
    "http://127.0.0.1/*",
    "https://qbo.intuit.com/*",
    "https://*.qbo.intuit.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "TimeTracker URL Reporter"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
