/**
 * DailyReview.tsx - Auto-populated by AI (user only corrects mistakes)
 * Replace your existing DailyReview.tsx with this version
 */

import { useEffect, useMemo, useState } from "react";
import { BlockDto } from "../types";
import { downloadTodayCsv, fetchBlocksToday } from "../api/blocks";
import BlockCard from "../components/BlockCard";
import Navigation from "../components/Navigation";

const API_BASE = import.meta.env.VITE_API_BASE_URL || 'api';

export default function DailyReview() {
  const [blocks, setBlocks] = useState<BlockDto[] | null>(null);
  const [busy, setBusy] = useState(false);
  const [autoClassifying, setAutoClassifying] = useState(false);

  // Load blocks and auto-classify them
  const load = async () => {
    setBusy(true);
    try {
      // 1. Get today's blocks
      const rawBlocks = await fetchBlocksToday();
      
      // 2. Get AI classifications for ALL blocks at once
      setAutoClassifying(true);
      const aiResponse = await fetch(`${API_BASE}/ai-suggestions-today/`);
      const aiSuggestions = await aiResponse.json();
      
      // 3. AUTO-APPLY AI classifications to blocks
      const autoClassifiedBlocks = rawBlocks.map((block) => {
        const aiSuggestion = aiSuggestions.find((s: any) => s.block_id === block.id);
        
        if (aiSuggestion?.ai_suggestion) {
          const suggestion = aiSuggestion.ai_suggestion;
          
          // Auto-populate the block with AI classification
          return {
            ...block,
            client_name: suggestion.client || block.client_name,
            project_name: suggestion.project || block.project_name,
            categories: suggestion.categories || {},
            ai_confidence: suggestion.confidence || 0,
            needs_review: suggestion.needs_review || false,
            ai_reasoning: suggestion.reasoning || "",
            // Keep suggestions array for manual override if needed
            suggestions: block.suggestions || [],
          };
        }
        
        return {
          ...block,
          needs_review: true, // No AI classification - needs manual review
          ai_confidence: 0,
        };
      });
      
      setBlocks(autoClassifiedBlocks);
      
      // 4. Save AI classifications to backend
      await Promise.all(
        autoClassifiedBlocks.map(async (block) => {
          if (block.client_name || block.project_name) {
            try {
              await fetch(`${API_BASE}/label-block/`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  block_id: block.id,
                  client: block.client_name,
                  project: block.project_name,
                  categories: block.categories || {},
                }),
              });
            } catch (error) {
              console.error(`Failed to save classification for block ${block.id}:`, error);
            }
          }
        })
      );
      
      console.log('✅ AI auto-classified all blocks!');
    } catch (error) {
      console.error('Failed to auto-classify:', error);
      // Fallback: just load blocks without AI
      const rawBlocks = await fetchBlocksToday();
      setBlocks(rawBlocks.map(b => ({ ...b, needs_review: true })));
    } finally {
      setBusy(false);
      setAutoClassifying(false);
    }
  };

  useEffect(() => {
    load();
  }, []);

  const totalMinutes = useMemo(
    () => (blocks?.reduce((acc, b) => acc + b.minutes, 0) ?? 0),
    [blocks]
  );

  const downloadCsv = async () => {
    const blob = await downloadTodayCsv();
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "blocks_today.csv";
    a.click();
    URL.revokeObjectURL(url);
  };

  // Count blocks by status
  const stats = useMemo(() => {
    if (!blocks) return { total: 0, autoClassified: 0, needsReview: 0, highConfidence: 0 };
    
    return {
      total: blocks.length,
      autoClassified: blocks.filter(b => b.ai_confidence > 0).length,
      needsReview: blocks.filter(b => b.needs_review).length,
      highConfidence: blocks.filter(b => b.ai_confidence >= 0.8).length,
    };
  }, [blocks]);

  return (
    <>
      <Navigation />
      <div className="p-6 max-w-4xl mx-auto space-y-6">
        <header className="flex items-center justify-between">
          <div>
            <h1 className="text-2xl font-semibold">Daily Review</h1>
            <p className="text-sm text-gray-600 mt-1">
              {autoClassifying ? (
                "🤖 AI is auto-classifying your time blocks..."
              ) : (
                "AI has classified your time. Review and correct any mistakes."
              )}
            </p>
          </div>
          <button
            onClick={downloadCsv}
            className="border rounded-lg px-4 py-2 hover:bg-gray-50"
          >
            Export CSV
          </button>
        </header>

        {/* Stats Cards */}
        <div className="grid grid-cols-4 gap-4">
          <div className="bg-white rounded-lg border p-4">
            <div className="text-2xl font-bold">{stats.total}</div>
            <div className="text-sm text-gray-600">Total Blocks</div>
          </div>
          
          <div className="bg-green-50 rounded-lg border border-green-200 p-4">
            <div className="text-2xl font-bold text-green-700">{stats.autoClassified}</div>
            <div className="text-sm text-green-700">Auto-Classified</div>
          </div>
          
          <div className="bg-blue-50 rounded-lg border border-blue-200 p-4">
            <div className="text-2xl font-bold text-blue-700">{stats.highConfidence}</div>
            <div className="text-sm text-blue-700">High Confidence</div>
          </div>
          
          <div className="bg-yellow-50 rounded-lg border border-yellow-200 p-4">
            <div className="text-2xl font-bold text-yellow-700">{stats.needsReview}</div>
            <div className="text-sm text-yellow-700">Needs Review</div>
          </div>
        </div>

        {/* Info Banner */}
        {blocks && blocks.length > 0 && (
          <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <div className="flex items-start gap-3">
              <span className="text-2xl">🤖</span>
              <div className="flex-1">
                <h3 className="font-medium text-blue-900">AI Auto-Classification Active</h3>
                <p className="text-sm text-blue-700 mt-1">
                  All blocks have been automatically classified. 
                  <strong> {stats.highConfidence} blocks</strong> have high confidence (≥80%).
                  Review and correct any mistakes below.
                </p>
                {stats.needsReview > 0 && (
                  <p className="text-sm text-yellow-700 mt-2">
                    ⚠️ <strong>{stats.needsReview} blocks</strong> need manual review (low confidence)
                  </p>
                )}
              </div>
            </div>
          </div>
        )}

        {/* Total Time */}
        <div className="text-sm text-gray-600">
          {busy ? (
            "Loading..."
          ) : (
            <>
              <strong>Total: {(totalMinutes / 60).toFixed(1)} hours</strong> ({totalMinutes} minutes) across {blocks?.length ?? 0} blocks
            </>
          )}
        </div>

        {/* Blocks List */}
        <div className="space-y-4">
          {blocks?.map((b) => (
            <BlockCard
              key={b.id}
              block={b}
              onLabeled={async (updatedData, originalSuggestion) => {
                // Save training example when user corrects
                try {
                  await fetch(`${API_BASE}/settings/training/`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      block_id: b.id,
                      text_content: `${b.title || ''} ${b.description || ''}`,
                      correct_client_id: updatedData.client_id,
                      correct_project_id: updatedData.project_id,
                      correct_categories: updatedData.category_hours || {},
                      original_prediction: originalSuggestion || {},
                    }),
                  });
                  console.log('✓ AI learned from your correction!');
                } catch (error) {
                  console.error('Failed to save training:', error);
                }
                
                await load();
              }}
            />
          ))}
          
          {!blocks?.length && !busy && (
            <div className="text-center py-12 text-gray-500">
              <p className="text-4xl mb-4">📅</p>
              <p>No blocks yet today.</p>
              <p className="text-sm mt-2">Your calendar events and activity will appear here automatically.</p>
            </div>
          )}
        </div>
      </div>
    </>
  );
}
