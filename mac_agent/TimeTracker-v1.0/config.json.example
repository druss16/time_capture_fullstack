{
  "api_url": "https://api.yourdomain.com/api/raw-events/",
  "api_key": "your-secret-api-key-here",
  "min_dwell_seconds": 15,
  "poll_seconds": 5,
  "verbose": true,
  "print_every": false,
  "disable_ax": false,
  "exclude_bundles": [
    "com.apple.systempreferences",
    "com.apple.ActivityMonitor"
  ]
}

{
  "api_base": "http://localhost:7123/api",
  "context_guess_url": "http://127.0.0.1:8901",
  "context_confirm_url": "http://localhost:7123/api/context/confirm",
  "context_reject_url": "http://localhost:7123/api/context/reject"
}
