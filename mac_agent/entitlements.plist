<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime apps must declare this to send Apple events or to ask
	     AEDeterminePermissionToAutomateTarget whether they may (permissions.py).
	     Used by codesign in .github/workflows/release.yml and TimeTracker.spec. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
