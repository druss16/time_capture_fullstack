<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>Services</key>
      <dict>
        <key>Accessibility</key>
        <array>
          <dict>
            <key>Allowed</key><true/>
            <key>CodeRequirement</key>
            <string>identifier TimeTrackerAgent and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = P3KX4CDFN4</string>
            <key>Identifier</key><string>TimeTrackerAgent</string>
            <key>IdentifierType</key><string>bundleID</string>
            <key>StaticCode</key><true/>
          </dict>
        </array>
      </dict>
      <key>PayloadDisplayName</key><string>PPPC: TimeTrackerAgent Accessibility</string>
      <key>PayloadIdentifier</key><string>com.mavops.pppc.timetrackeragent</string>
      <key>PayloadType</key><string>com.apple.TCC.configuration-profile-policy</string>
      <key>PayloadUUID</key><string>F2A5B4B6-5F0C-4F8D-9D6B-PPPC-AX-0001</string>
      <key>PayloadVersion</key><integer>1</integer>
    </dict>
  </array>

  <key>PayloadDisplayName</key><string>MavOps PPPC – TimeTrackerAgent</string>
