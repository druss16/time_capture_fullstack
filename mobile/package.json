{
  "name": "timetracker-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "build:ios": "npm run version:patch && eas build --platform ios --profile production",
    "build:android": "npm run version:patch && eas build --platform android --profile production",
    "build:all": "npm run version:patch && eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update --branch production --message 'OTA update'",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^4.6.3",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "@tanstack/react-query": "^5.40.0",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-background-fetch": "~13.0.6",
    "expo-calendar": "~14.0.6",
    "expo-constants": "~17.0.8",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.1",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-task-manager": "~12.0.6",
    "expo-updates": "~0.27.5",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.1.3"
  }
}
